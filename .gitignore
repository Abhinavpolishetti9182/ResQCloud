# =========================================================
# ResQCloud - Git Ignore
# =========================================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Local databases and database backups
*.db
*.sqlite
*.sqlite3

# ResQCloud generated/test backup files
backend/data/
backend/restored/
backend/restored_backups/

# AWS / private keys
*.pem
*.key

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Terraform generated files
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
*.backup
crash.log
crash.*.log

# Terraform local variables
terraform.tfvars

# Build / distribution
build/
dist/
*.egg-info/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
